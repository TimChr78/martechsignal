/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://analytics.martechsignal.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://martechsignal.com; connect-src 'self' https://analytics.martechsignal.com https://cloudflareinsights.com https://app.kit.com; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://app.kit.com
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  # T-1 (v2.4.0 audit): the security headers and the HTML micro-cache MUST share ONE
  # /* block. Cloudflare Pages replaces the whole block when a path pattern repeats —
  # a second /* block with only Cache-Control silently dropped HSTS/CSP/XFO above.
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=60

/style.css
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/rss.xml
  Cache-Control: public, max-age=300
/sitemap.xml
  Cache-Control: public, max-age=3600
/og/*
  Cache-Control: public, max-age=2592000
/llms.txt
  Cache-Control: public, max-age=3600
/llms-full.txt
  Cache-Control: public, max-age=3600
